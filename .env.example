# API-ключ Cloud.ru Foundation Models API (передается через системное окружение или файл .env)
API_KEY=your_cloud_ru_api_key_here

# Официальный шлюз моделей Cloud.ru
BASE_URL=https://foundation-models.api.cloud.ru/v1

# Актуальная модель GigaChat (<= 40 млрд параметров по Разделу 3 регламента)
MODEL_NAME=GigaChat/GigaChat-2-Max

# Сетевые параметры HTTP-сервера
HOST=0.0.0.0
PORT=8000
